# Copy to .env in this directory. The .env file is gitignored.
# Used by the MCP server and by scripts/export_my_rosters.py.

# Season the tools default to.
ESPN_SEASON=2026

# Default league id. This is the leagueId query parameter in a fantasy.espn.com URL.
# Tools also accept league_id per call, so this is optional.
ESPN_LEAGUE_ID=

# Only needed for private leagues. In a logged-in browser, open DevTools ->
# Application -> Cookies -> https://fantasy.espn.com and copy these two values.
# Keep the curly braces on SWID.
ESPN_S2=
ESPN_SWID=

# Katie's ESPN login for the hosted MCP. Same cookie names from her browser.
# Local stdio keeps using ESPN_S2 and ESPN_SWID above.
ESPN_S2_KATIE=
ESPN_SWID_KATIE=

# Bearer tokens for the public Streamable HTTP server (espn-mcp-http).
# Generate a long random value for each person. Never commit the real tokens.
MCP_AUTH_TOKEN=
MCP_AUTH_TOKEN_KATIE=

# ChatGPT sign-in. The public origin has no trailing slash.
MCP_LOGIN_PASSWORD=
MCP_PUBLIC_URL=

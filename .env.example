VITE_API_BASE_URL=http://localhost:8000
FANTASY_DRAFT_CORS_ORIGINS=http://localhost:5173
FANTASY_DRAFT_LOG_LEVEL=INFO
FANTASYPROS_API_KEY=
# The Odds API key for Week D/ST spreads + totals (https://the-odds-api.com/)
ODDS_API_KEY=
# Optional: seconds to cache odds in the API process (default 1800)
ODDS_CACHE_TTL_SECONDS=1800
# Optional: ISO date of the Tuesday that starts NFL fantasy Week 1 (default 2026-09-08)
NFL_SEASON_WEEK1_TUESDAY=2026-09-08
# Optional: seconds to cache Kyle DST FantasyPros scrape (default 1800)
KYLE_DST_CACHE_TTL_SECONDS=1800
# Optional: seconds to cache Jared Smola weekly K FantasyPros scrape (default 1800)
JARED_K_CACHE_TTL_SECONDS=1800
# ESPN cookies for Week D/ST + Week K available cross-ref (private leagues).
# Same values as tools/espn-mcp/.env — never commit real cookies.
ESPN_SEASON=2026
ESPN_S2=
ESPN_SWID=
